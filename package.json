{
  "name": "webgl-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "validate:workflow": "node scripts/validate-workflow-policy.mjs",
    "validate:content": "bun scripts/validate-content.ts",
    "generate:static": "bun scripts/generate-static-site.ts",
    "harden:homepage": "bun scripts/harden-homepage.ts",
    "finalize:static": "bun scripts/finalize-static-site.ts",
    "normalize:artifact": "node scripts/normalize-artifact.mjs",
    "build": "bun run validate:workflow && bun run typecheck && bun run validate:content && vite build && bun run generate:static && bun run harden:homepage && bun run finalize:static && bun run normalize:artifact && bun run validate:dist",
    "validate:dist": "node scripts/validate-dist.mjs && node scripts/validate-public-claims.mjs",
    "test:adversarial": "node scripts/test-adversarial.mjs",
    "hash:dist": "node scripts/hash-dist-tree.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lenis": "^1.1.14",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  }
}
